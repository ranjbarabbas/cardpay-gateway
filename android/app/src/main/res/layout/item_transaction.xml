<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layoutDirection="rtl"
    app:cardBackgroundColor="?attr/appSurfaceColor"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/appCardStrokeColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Bank Sender & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/tvStatusBadge"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="B.QMEHRIRAN" />

                <TextView
                    android:id="@+id/tvBankSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:text="(سرخط تایید شده بانکی)"
                    android:textColor="?attr/appTextMuted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_matched"
                android:fontFamily="@font/vazirmatn_medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#166534"
                android:textSize="11sp"
                tools:text="تایید شده ✅" />
        </RelativeLayout>

        <!-- Second Row: Amount & Tracking Code -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_bold"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                tools:text="مبلغ: ۵۰,۰۱۵ تومان" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTrackingCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_regular"
                android:textColor="?attr/appTextMuted"
                android:textSize="11sp"
                tools:text="پیگیری: 748291" />
        </LinearLayout>

        <!-- Third Row: SMS Body Snippet -->
        <TextView
            android:id="@+id/tvSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_regular"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="?attr/appTextSecondary"
            android:textSize="11sp"
            tools:text="واریز: 500,150 ریال به حساب 111122223333444455 مانده: 1,250,000 ریال" />

        <!-- Bottom Row: Time -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/vazirmatn_regular"
            android:textColor="?attr/appTextMuted"
            android:textSize="10sp"
            tools:text="۱۴:۲۵ • ۱۴۰۵/۰۸/۲۲" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
