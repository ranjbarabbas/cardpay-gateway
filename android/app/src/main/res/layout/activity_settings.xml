<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Top App Bar with Standard Back Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/appHeaderBackground"
        android:elevation="3dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ripple_circle"
            android:contentDescription="بازگشت"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/appTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="56dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:text="تنظیمات درگاه و ظاهر"
            android:textColor="?attr/appTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Settings -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Theme Mode Selection Card (Dark / Light / System) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/appSurfaceColor"
                app:cardCornerRadius="22dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/appCardStrokeColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:text="پوسته و حالت ظاهری (Dark / Light Mode)"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="حالت تیره، روشن یا هماهنگ با سیستم عامل را انتخاب فرمایید."
                        android:textColor="?attr/appTextMuted"
                        android:textSize="11sp" />

                    <RadioGroup
                        android:id="@+id/rgThemeMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbThemeDark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn_medium"
                            android:text="🌙 حالت تیره (Dark Mode)"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="13sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbThemeLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn_medium"
                            android:text="☀️ حالت روشن (Light Mode)"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="13sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbThemeSystem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn_medium"
                            android:text="⚙️ هماهنگ با تنظیمات سیستم گوشی"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Configuration Card (Server & Token) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/appSurfaceColor"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/appCardStrokeColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:text="تنظیمات سرور و توکن دستگاه"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="آدرس سرور مرکزی و کلید دسترسی دستگاه را وارد نمایید."
                        android:textColor="?attr/appTextMuted"
                        android:textSize="11sp" />

                    <!-- Server URL Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="آدرس سرور مرکزی درگاه (Server URL)"
                        android:textColorHint="?attr/appTextMuted"
                        app:boxBackgroundColor="?attr/appInputBackground"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="?attr/colorPrimary"
                        app:hintTextColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServerUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn_medium"
                            android:inputType="textUri"
                            android:text="http://10.0.2.2:3050"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- API Key Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="کلید توکن دستگاه (Device API Key)"
                        android:textColorHint="?attr/appTextMuted"
                        app:boxBackgroundColor="?attr/appInputBackground"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="?attr/colorPrimary"
                        app:hintTextColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn_medium"
                            android:inputType="text"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSave"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="?attr/colorPrimary"
                            android:fontFamily="@font/vazirmatn_bold"
                            android:text="ذخیره تنظیمات"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTest"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/vazirmatn_bold"
                            android:text="تست اتصال"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"
                            app:cornerRadius="16dp"
                            app:strokeColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <!-- Connection Log Box -->
                    <TextView
                        android:id="@+id/tvTestResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="?attr/appLogBackground"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:padding="14dp"
                        android:text="نتیجه تست اتصال سرور در اینجا نمایش داده می‌شود."
                        android:textColor="?attr/appTextMuted"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Sticky Footer Bar: App Version & Branding -->
    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appFooterBackground"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvSettingsAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_medium"
            android:text="نسخه ۱.۲.۰ • سامانه هنر هاب"
            android:textColor="?attr/appTextMuted"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
