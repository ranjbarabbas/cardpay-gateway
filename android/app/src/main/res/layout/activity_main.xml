<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Top App Bar with App Logo, Title, Theme Toggle & Settings Icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/appHeaderBackground"
        android:elevation="3dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="هنر هاب"
                android:src="@drawable/app_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:text="همگام‌ساز پیامک هنرهاب پی"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:text="HonarHub Pay Engine"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Action Buttons: Theme Toggle & Settings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Theme Toggle Button (Light / Dark) -->
            <ImageButton
                android:id="@+id/btnToggleTheme"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/ripple_circle"
                android:contentDescription="تغییر تم برنامه (تیره / روشن)"
                android:padding="10dp"
                android:src="@drawable/ic_light_mode"
                app:tint="?attr/colorPrimary" />

            <!-- Setting Icon -->
            <ImageButton
                android:id="@+id/btnOpenSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ripple_circle"
                android:contentDescription="تنظیمات درگاه"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Active Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/appSurfaceColor"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/appCardStrokeColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/switchSync"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/vazirmatn_bold"
                                android:text="سرویس رصد هوشمند پیامک‌های بانکی"
                                android:textColor="?attr/appTextPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/vazirmatn_regular"
                                android:text="رصد خودکار واریزی‌ها و تایید بلادرنگ فاکتورها"
                                android:textColor="?attr/appTextMuted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSync"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:thumbTint="?attr/colorPrimary"
                            app:trackTint="?attr/appCardStrokeColor" />
                    </RelativeLayout>

                    <!-- Status Indicator Pill -->
                    <LinearLayout
                        android:id="@+id/statusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="?attr/appBackgroundColor"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#EF4444" />

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn_bold"
                            android:text="سرویس غیرفعال است"
                            android:textColor="#EF4444"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLastSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="آخرین وضعیت: پیامکی دریافت نشده است"
                        android:textColor="?attr/appTextSecondary"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Server Connection Summary Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/appSurfaceColor"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/appCardStrokeColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tvServerInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="سرور متصل: https://pay.honarhub.com"
                        android:textColor="?attr/appTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnQuickSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_circle"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="تنظیمات"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Bank Inbound SMS Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:text="سوابق ۱۰ تراکنش آخر دریافتی"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:text="صرفاً از سرخط‌های تایید شده بانکی و در حال بررسی"
                        android:textColor="?attr/appTextMuted"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnRefreshTransactions"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ripple_circle"
                    android:contentDescription="بروزرسانی سوابق تراکنش‌ها"
                    android:padding="8dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="?attr/colorPrimary" />
            </RelativeLayout>

            <!-- Empty State Card (Visible when list is empty) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutEmptyLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/appLogBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/appCardStrokeColor"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvEmptyLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:padding="24dp"
                    android:text="در انتظار دریافت اولین پیامک بانکی...\n(صرفاً پیامک‌های رسمی بانک از سرخط‌های تایید شده بانکی)"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Transactions RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Sticky Footer Bar: App Version & Branding -->
    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appFooterBackground"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_medium"
            android:text="نسخه ۱.۵.۰ • سامانه هنرهاب پی"
            android:textColor="?attr/appTextMuted"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
